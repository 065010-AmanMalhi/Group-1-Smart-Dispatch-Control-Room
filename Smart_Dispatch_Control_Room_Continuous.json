      "targets": [
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT d.zone, d.current_speed_kmph, d.live_eta_min, d.final_multiplier, d.active_incidents, CASE WHEN d.final_multiplier >= 1.55 THEN 'CRITICAL' WHEN d.final_multiplier >= 1.30 THEN 'WARNING' ELSE 'NORMAL' END AS alert_level, CASE d.zone WHEN 'Connaught Place' THEN 28.6315 WHEN 'AIIMS Corridor' THEN 28.5672 WHEN 'Ring Road South' THEN 28.5607 WHEN 'Dwarka Expressway' THEN 28.6250 WHEN 'Nehru Place' THEN 28.5491 END AS latitude, CASE d.zone WHEN 'Connaught Place' THEN 77.2167 WHEN 'AIIMS Corridor' THEN 77.2100 WHEN 'Ring Road South' THEN 77.2385 WHEN 'Dwarka Expressway' THEN 77.0450 WHEN 'Nehru Place' THEN 77.2507 END AS longitude FROM dispatch_decisions d JOIN (SELECT zone, MAX(decision_id) latest_id FROM dispatch_decisions GROUP BY zone) l ON d.decision_id=l.latest_id WHERE d.zone REGEXP '${zone:regex}';",
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT hospital_name, address, zone, latitude, longitude FROM hospitals ORDER BY hospital_name;",
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": "${DS_MYSQL}",
