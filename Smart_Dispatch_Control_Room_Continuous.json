        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT ambulance_id, route_seq, latitude, longitude, cumulative_distance_km FROM ambulance_routes WHERE ambulance_id = 'AMB-103' ORDER BY route_seq;",
          "format": "table",
