          "format": "table",
          "refId": "F"
        },
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT ambulance_id, route_seq, latitude, longitude, cumulative_distance_km FROM ambulance_routes WHERE ambulance_id = 'AMB-105' ORDER BY route_seq;",
          "format": "table",
          "refId": "G"
        },
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT\n  p.ambulance_id,\n  p.hospital,\n  p.destination,\n  p.zone,\n  p.latitude,\n  p.longitude,\n  p.speed_kmph,\n  p.route_progress_pct,\n  p.remaining_distance_km,\n  p.eta_min,\n  p.final_multiplier,\n  p.status,\n  p.event_time,\n  COALESCE(\n    DEGREES(\n      ATAN2(\n        (p.longitude - prev.longitude) * COS(RADIANS(p.latitude)),\n        p.latitude - prev.latitude\n      )\n    ),\n    0\n  ) AS heading_deg\nFROM ambulance_positions p\nLEFT JOIN ambulance_positions prev\n  ON prev.position_id = (\n    SELECT MAX(p2.position_id)\n    FROM ambulance_positions p2\n    WHERE p2.ambulance_id = p.ambulance_id\n      AND p2.position_id < p.position_id\n  )\nJOIN (\n  SELECT ambulance_id, MAX(position_id) AS latest_id\n  FROM ambulance_positions\n  GROUP BY ambulance_id\n) l\n  ON p.position_id = l.latest_id\nORDER BY p.ambulance_id;",
          "format": "table",
          "refId": "H"
        }
