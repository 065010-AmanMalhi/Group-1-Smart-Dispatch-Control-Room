      "targets": [
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT ROUND(MAX((d.live_eta_min/d.baseline_eta_min-1)*100),1) AS value FROM dispatch_decisions d JOIN (SELECT zone, MAX(decision_id) latest_id FROM dispatch_decisions GROUP BY zone) l ON d.decision_id=l.latest_id WHERE d.zone REGEXP '${zone:regex}';",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 55
              }
            ]
