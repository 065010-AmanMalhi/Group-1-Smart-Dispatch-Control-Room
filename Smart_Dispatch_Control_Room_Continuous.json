  "title": "Smart Dispatch Control Room | Operations + Live Ambulance Fleet",
  "uid": "smart-dispatch-control-room",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "zone",
        "type": "query",
        "label": "Zone",
        "datasource": "${DS_MYSQL}",
        "query": "SELECT DISTINCT zone AS __text, zone AS __value FROM dispatch_decisions ORDER BY zone;",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 0,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "# 🚑 Smart Dispatch Control Room\n**Live emergency-vehicle ETA intelligence across 5 Delhi zones** — Kafka → MySQL → Grafana, synthetic streaming scenario with explainable delay factors.\n\n> **Control-room view:** risk, ETA impact, traffic conditions, active incidents and the reason behind every multiplier."
      }
    },
    {
      "id": 10,
      "title": "🚨 Critical Alerts",
      "type": "stat",
      "datasource": "${DS_MYSQL}",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT COUNT(*) AS value FROM alerts_log WHERE alert_level='CRITICAL' AND triggered_time >= NOW() - INTERVAL 5 MINUTE;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 11,
      "title": "⚠️ Zones at Risk",
      "type": "stat",
      "datasource": "${DS_MYSQL}",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 3
      },
      "targets": [
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT COUNT(*) AS value FROM (SELECT zone, MAX(decision_id) latest_id FROM dispatch_decisions GROUP BY zone) l JOIN dispatch_decisions d ON d.decision_id=l.latest_id WHERE d.final_multiplier >= 1.30 AND d.zone REGEXP '${zone:regex}';",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 12,
      "title": "⏱️ Avg Live ETA",
      "type": "stat",
      "datasource": "${DS_MYSQL}",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 3
      },
      "targets": [
        {
          "datasource": "${DS_MYSQL}",
          "rawSql": "SELECT ROUND(AVG(d.live_eta_min),1) AS value FROM dispatch_decisions d JOIN (SELECT zone, MAX(decision_id) latest_id FROM dispatch_decisions GROUP BY zone) l ON d.decision_id=l.latest_id WHERE d.zone REGEXP '${zone:regex}';",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "red",
                "value": 12
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
