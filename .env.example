# Copy to .env and set values for your local machine.
# Do not commit .env or place real credentials in this template.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_local_mysql_password
MYSQL_DATABASE=sda_smart_dispatch

# Optional email alert settings (only used if enabled in config.py)
SMTP_SENDER_EMAIL=your_project_email@gmail.com
SMTP_SENDER_APP_PASSWORD=
ALERT_RECIPIENT_EMAIL=your_team_email@gmail.com
